# ==============================================================================
# Environment Configuration for Dialogue Bot Detection Production Stack
# ==============================================================================

# 1. API Gateway Configuration
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_WORKERS=2
LOG_LEVEL=INFO

# 2. Redis Cache & Distributed Task Store
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_CACHE_DEFAULT_TTL_SEC=86400
REDIS_TASK_DEFAULT_TTL_SEC=3600

# 3. NVIDIA Triton Inference Server
TRITON_URL=http://localhost:8000
TRITON_GRPC_URL=localhost:8001
TRITON_PROTOCOL=grpc
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8002

# 4. RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# 5. ClickHouse DWH
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=bot_detection
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# 6. Observability: Prometheus, Grafana, Alertmanager
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_PORT=9093
NTFY_URL=https://ntfy.sh/bot-detector-alerts

# 7. MLflow & Prefect Automation
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
PREFECT_PORT=4200
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_LOGGING_LEVEL=INFO
SCHEDULE_DRIFT_MONITORING_CRON=*/2 * * * *
SCHEDULE_AUTO_TRIGGER_RETRAIN=false
