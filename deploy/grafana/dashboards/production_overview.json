          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Verdict Distribution",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (verdict) (increase(bot_detector_predictions_total[1m]))",
          "legendFormat": "{{verdict}}"
        }
      ],
      "description": "Distribution of classified dialogue verdicts (both humans, both bots, participant 0 bot, participant 1 bot)."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
