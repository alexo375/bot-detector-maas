          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Inference Throughput",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(nv_inference_exec_count[1m])) by (model)",
          "legendFormat": "{{model}}"
        }
      ],
      "description": "Execution rate of inference operations across Triton models (CatBoost, LightGBM, XGBoost, Meta-Stacker)."
