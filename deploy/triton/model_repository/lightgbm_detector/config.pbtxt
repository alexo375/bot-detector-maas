name: "lightgbm_detector"
platform: "onnxruntime_onnx"
max_batch_size: 64

version_policy: {
  latest: { num_versions: 1 }
}

input [
  {
    name: "float_input"
    data_type: TYPE_FP32
    dims: [ 236 ]
  }
]
output [
  {
    name: "label"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "probabilities"
    data_type: TYPE_FP32
    dims: [ 2 ]
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 5000
}

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]
